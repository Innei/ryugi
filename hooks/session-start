#!/usr/bin/env bash
# SessionStart hook for ryugi plugin

set -euo pipefail

# Determine plugin root directory.
# Splits $0 on its last / or \ (run-hook.cmd's cmd half passes a Windows
# path), with no separator meaning the current directory. This avoids
# dirname because a SessionStart:startup hook can run with a broken/empty
# PATH (anthropics/claude-code#43127) before any PATH-repairing sibling hook
# in the same startup batch takes effect.
env_plugin_root="${PLUGIN_ROOT:-}"
env_plugin_data="${PLUGIN_DATA:-}"

case "$0" in
  */* | *\\*) SCRIPT_DIR="$(cd "${0%[/\\]*}" && pwd)" ;;
  *) SCRIPT_DIR="$(pwd)" ;;
esac
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
. "${SCRIPT_DIR}/../skills/artifacts/app/hook-bin.sh"
hook_bin="$(ryugi_hook_bin "$PLUGIN_ROOT")" || hook_bin=""
if [ -z "$hook_bin" ] && [ -z "${CURSOR_PLUGIN_ROOT:-}" ] && command -v node > /dev/null 2>&1; then
  node "${PLUGIN_ROOT}/skills/artifacts/app/ryugi.cjs" hook-install < /dev/null > /dev/null 2>&1 &
fi

# Only treat this invocation as Antigravity when an Antigravity hook marker
# (ANTIGRAVITY_AGENT, or Antigravity's plugin hook PLUGIN_ROOT/PLUGIN_DATA) is
# set AND no foreign harness plugin root / CLI marker is active (so launching
# Claude, Cursor, Copilot CLI, or Muse from an Antigravity terminal does not
# hijack them).
is_antigravity=0
if { [ -n "${ANTIGRAVITY_AGENT:-}" ] || [ -n "$env_plugin_root" ] || [ -n "$env_plugin_data" ]; } \
  && [ -z "${CURSOR_PLUGIN_ROOT:-}" ] \
  && [ -z "${CLAUDE_PLUGIN_ROOT:-}" ] \
  && [ -z "${CLAUDE_PROJECT_DIR:-}" ] \
  && [ -z "${MUSE_PLUGIN_ROOT:-}" ] \
  && [ -z "${COPILOT_CLI:-}" ]; then
  is_antigravity=1
fi

# Read using-adeck content via bash's builtin $(< file) instead of
# cat, for the same PATH-independence reason.
skill_md="${PLUGIN_ROOT}/skills/using-adeck/SKILL.md"
has_using_adeck=0
if [ -r "$skill_md" ]; then
  has_using_adeck=1
  using_adeck_content="$(< "$skill_md")"
else
  using_adeck_content="Error reading using-adeck skill"
fi

# Escape string for JSON embedding using bash parameter substitution.
# Each ${s//old/new} is a single C-level pass - orders of magnitude
# faster than the character-by-character loop this replaces.
escape_for_json() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

using_adeck_escaped=$(escape_for_json "$using_adeck_content")
if [ "$is_antigravity" -eq 1 ]; then
  session_context="<EXTREMELY_IMPORTANT>\nYou have Artideck.\n\n**Below is the full content of your 'adeck:using-adeck' skill - your introduction to using skills. To load another skill on Antigravity, read its SKILL.md with \`read_file\`:**\n\n${using_adeck_escaped}\n</EXTREMELY_IMPORTANT>"
else
  session_context="<EXTREMELY_IMPORTANT>\nYou have Artideck.\n\n**Below is the full content of your 'adeck:using-adeck' skill - your introduction to using skills. For all other skills, use the 'Skill' tool:**\n\n${using_adeck_escaped}\n</EXTREMELY_IMPORTANT>"
fi

emit_json() {
  # shellcheck disable=SC2059 # every caller passes a literal format string
  if command -v cat > /dev/null 2>&1; then
    printf "$@" | cat
  else
    printf "$@"
  fi
}

stdin_payload=""
if [ "$is_antigravity" -eq 1 ] && [ ! -t 0 ]; then
  IFS= read -r -d '' stdin_payload || true
fi

# A project with published documents gets its artifacts server for the whole
# session, so its owner can comment from the cloud. Backgrounded and silent:
# it must never delay or break session start, and skips when adeck-hook is missing.
project_dir="${CLAUDE_PROJECT_DIR:-}"
if [ -z "$project_dir" ] && [ "$is_antigravity" -eq 1 ] && [ -n "$stdin_payload" ] && [ -n "$hook_bin" ]; then
  project_dir="$(printf '%s' "$stdin_payload" | "$hook_bin" agy-cwd 2> /dev/null || true)"
fi
if [ -n "$project_dir" ]; then
  . "${SCRIPT_DIR}/project-root.sh"
  project_dir="$(ryugi_project_root "$project_dir")"
fi
if { [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] || [ "$is_antigravity" -eq 1 ]; } && [ -z "${CURSOR_PLUGIN_ROOT:-}" ] && [ "${OS:-}" != "Windows_NT" ] && [ -n "$project_dir" ] \
  && [ -f "$(ryugi_store "$project_dir")/config.json" ] && [ -n "$hook_bin" ]; then
  RYUGI_ARTIFACTS_OWNER="$PPID" RYUGI_PLUGIN_ROOT="$PLUGIN_ROOT" "$hook_bin" start "$project_dir" < /dev/null > /dev/null 2>&1 &
fi

if [ "$is_antigravity" -eq 1 ] && [ -n "${ANTIGRAVITY_LS_ADDRESS:-}" ] && [ -n "$hook_bin" ]; then
  printf '%s' "$stdin_payload" | RYUGI_PLUGIN_ROOT="$PLUGIN_ROOT" "$hook_bin" detach watch antigravity > /dev/null 2>&1 || true
fi

# The adeck-lite and ryugi-artifacts marketplace entries load only the artifacts
# skills but still run every hook. Their data dir (<entry>-<marketplace>) names
# the entry for every marketplace source; a directory source runs hooks from the
# source checkout, so the cache path alone cannot tell.
plugin_data="${CLAUDE_PLUGIN_DATA:-${env_plugin_data}}"
plugin_entry="${plugin_data##*[/\\]}"
lite=0
case "$plugin_entry" in
  adeck-lite | adeck-lite-* | ryugi-artifacts | ryugi-artifacts-*) lite=1 ;;
esac
case "$PLUGIN_ROOT" in
  */adeck-lite | */adeck-lite/* | *\\adeck-lite | *\\adeck-lite\\* | */ryugi-artifacts | */ryugi-artifacts/* | *\\ryugi-artifacts | *\\ryugi-artifacts\\*) lite=1 ;;
esac

# Claude Code keeps a marketplace entry's id, so an install made before the
# rename runs as ryugi@ryugi-dev until `adeck plugin-migrate` moves it.
legacy_id=""
if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${CURSOR_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ] && [ -z "${MUSE_PLUGIN_ROOT:-}" ]; then
  case "$plugin_entry" in
    ryugi-artifacts-ryugi-dev) legacy_id="ryugi-artifacts@ryugi-dev" ;;
    ryugi-ryugi-dev) legacy_id="ryugi@ryugi-dev" ;;
  esac
  case "$PLUGIN_ROOT" in
    */ryugi-dev/ryugi-artifacts/* | *\\ryugi-dev\\ryugi-artifacts\\*) legacy_id="ryugi-artifacts@ryugi-dev" ;;
    */ryugi-dev/ryugi/* | *\\ryugi-dev\\ryugi\\*) legacy_id="ryugi@ryugi-dev" ;;
  esac
fi
if [ -n "$legacy_id" ] && command -v node > /dev/null 2>&1; then
  node "${PLUGIN_ROOT}/skills/artifacts/app/adeck.cjs" plugin-migrate --format quiet < /dev/null > /dev/null 2>&1 &
fi

if [ "$lite" -eq 1 ]; then
  if [ "$is_antigravity" -eq 1 ]; then emit_json '{}\n'; fi
  exit 0
fi

if [ -n "$legacy_id" ]; then
  session_context="${session_context}\n\nThis session loaded Artideck under its old id ${legacy_id}, so its skills are named ryugi:<skill>. Where a skill says adeck:<skill>, use ryugi:<skill>. Artideck moves this install to adeck@ryugi-dev on its own."
  migration_state="${HOME:-}/.artideck/plugin-migration.json"
  [ -d "${HOME:-}/.artideck" ] || migration_state="${HOME:-}/.ryugi/plugin-migration.json"
  if [ -r "$migration_state" ] && [[ "$(< "$migration_state")" == *'"notice": true'* ]]; then
    session_context="${session_context}\n\nMoving it failed three times. Ask the user to run: claude plugin install adeck@ryugi-dev --scope user, then claude plugin uninstall ${legacy_id} --scope user."
  fi
  for settings in "${CLAUDE_PROJECT_DIR:-}/.claude/settings.json" "${CLAUDE_PROJECT_DIR:-}/.claude/settings.local.json"; do
    if [ -n "${CLAUDE_PROJECT_DIR:-}" ] && [ -r "$settings" ] && [[ "$(< "$settings")" == *'"ryugi@ryugi-dev"'* || "$(< "$settings")" == *'"ryugi-artifacts@ryugi-dev"'* ]]; then
      session_context="${session_context}\n\nThis project's ${settings#"${CLAUDE_PROJECT_DIR}/"} still enables ryugi@ryugi-dev; suggest the user rename it to adeck@ryugi-dev (or ryugi-artifacts@ryugi-dev to adeck-lite@ryugi-dev)."
    fi
  done
fi

if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  # Cursor sets CURSOR_PLUGIN_ROOT (may also set CLAUDE_PLUGIN_ROOT)
  emit_json '{\n  "additional_context": "%s"\n}\n' "$session_context"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ] && [ -z "${MUSE_PLUGIN_ROOT:-}" ]; then
  # Claude Code sets CLAUDE_PLUGIN_ROOT without COPILOT_CLI/MUSE_PLUGIN_ROOT
  emit_json '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"
elif [ -n "${MUSE_PLUGIN_ROOT:-}" ]; then
  # Muse sets MUSE_PLUGIN_ROOT — try Claude-style nested output for Muse Spark
  emit_json '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"
elif [ "$is_antigravity" -eq 1 ]; then
  if [ "$has_using_adeck" -eq 0 ]; then
    emit_json '{}\n'
  else
    emit_json '{\n  "injectSteps": [\n    {\n      "systemMessage": {\n        "systemMessage": "%s"\n      }\n    }\n  ]\n}\n' "$session_context"
  fi
else
  # Copilot CLI (sets COPILOT_CLI=1) or unknown platform — SDK standard format
  emit_json '{\n  "additionalContext": "%s"\n}\n' "$session_context"
fi

exit 0
