#!/usr/bin/env bash
set -uo pipefail

case "$0" in
  */* | *\\*) SCRIPT_DIR="$(cd "${0%[/\\]*}" && pwd)" ;;
  *) SCRIPT_DIR="$(pwd)" ;;
esac
. "$SCRIPT_DIR/../skills/artifacts/app/hook-bin.sh"

if { [ -n "${ANTIGRAVITY_AGENT:-}" ] || [ -n "${PLUGIN_ROOT:-}" ] || [ -n "${PLUGIN_DATA:-}" ]; } \
  && [ -z "${CLAUDE_PROJECT_DIR:-}" ] \
  && [ -z "${CLAUDE_PLUGIN_ROOT:-}" ] \
  && [ -z "${CURSOR_PLUGIN_ROOT:-}" ] \
  && [ -z "${ZCODE_PLUGIN_ROOT:-}" ] \
  && [ -z "${MUSE_PLUGIN_ROOT:-}" ] \
  && [ -z "${COPILOT_CLI:-}" ]; then
  if bin="$(ryugi_hook_bin "${SCRIPT_DIR%[/\\]*}")"; then
    exec "$bin" event antigravity
  fi
  # Antigravity treats {} on PreToolUse as a deny, so only that event stays silent.
  payload=""
  [ -t 0 ] || IFS= read -r -d '' payload || true
  case "$payload" in
    *'"hookEventName"'*'"PreToolUse"'*) ;;
    *) printf '{}\n' ;;
  esac
  exit 0
fi

. "$SCRIPT_DIR/project-root.sh"
project="$(ryugi_project_root "${CLAUDE_PROJECT_DIR:-$PWD}")"
[ -f "$(ryugi_store "$project")/artifacts/.state/server-info" ] || [ -f "$project/.git" ] || exit 0
bin="$(ryugi_hook_bin "${SCRIPT_DIR%[/\\]*}")" || exit 0

"$bin" event claude "$project" > /dev/null 2>&1
exit 0
