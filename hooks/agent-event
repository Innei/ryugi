#!/usr/bin/env bash
set -uo pipefail

case "$0" in
  */* | *\\*) SCRIPT_DIR="$(cd "${0%[/\\]*}" && pwd)" ;;
  *) SCRIPT_DIR="$(pwd)" ;;
esac

if { [ -n "${ANTIGRAVITY_AGENT:-}" ] || [ -n "${PLUGIN_ROOT:-}" ] || [ -n "${PLUGIN_DATA:-}" ]; } \
  && [ -z "${CLAUDE_PROJECT_DIR:-}" ] \
  && [ -z "${CLAUDE_PLUGIN_ROOT:-}" ] \
  && [ -z "${CURSOR_PLUGIN_ROOT:-}" ] \
  && [ -z "${MUSE_PLUGIN_ROOT:-}" ] \
  && [ -z "${COPILOT_CLI:-}" ]; then
  if command -v node > /dev/null 2>&1; then
    node "$SCRIPT_DIR/../skills/artifacts/app/agent-event.cjs" antigravity
  else
    printf '{}\n'
  fi
  exit 0
fi

. "$SCRIPT_DIR/project-root.sh"
project="$(ryugi_project_root "${CLAUDE_PROJECT_DIR:-$PWD}")"
[ -f "$project/.ryugi/artifacts/.state/server-info" ] || exit 0
command -v node > /dev/null 2>&1 || exit 0

node "$SCRIPT_DIR/../skills/artifacts/app/agent-event.cjs" claude "$project" > /dev/null 2>&1
exit 0
