#!/usr/bin/env bash
set -uo pipefail

case "$0" in
  */* | *\\*) SCRIPT_DIR="$(cd "${0%[/\\]*}" && pwd)" ;;
  *) SCRIPT_DIR="$(pwd)" ;;
esac
. "$SCRIPT_DIR/../skills/artifacts/app/hook-bin.sh"
export RYUGI_PLUGIN_ROOT="${SCRIPT_DIR%[/\\]*}"

is_antigravity=0
if { [ -n "${ANTIGRAVITY_AGENT:-}" ] || [ -n "${PLUGIN_ROOT:-}" ] || [ -n "${PLUGIN_DATA:-}" ]; } \
  && [ -z "${CLAUDE_PROJECT_DIR:-}" ] \
  && [ -z "${CLAUDE_PLUGIN_ROOT:-}" ] \
  && [ -z "${CURSOR_PLUGIN_ROOT:-}" ] \
  && [ -z "${MUSE_PLUGIN_ROOT:-}" ] \
  && [ -z "${COPILOT_CLI:-}" ]; then
  is_antigravity=1
fi

if ! bin="$(ryugi_hook_bin "$RYUGI_PLUGIN_ROOT")"; then
  [ "$is_antigravity" -eq 1 ] && printf '{}\n'
  exit 0
fi

. "$SCRIPT_DIR/project-root.sh"
if [ "$is_antigravity" -eq 1 ]; then
  exec "$bin" context
fi

session="$(ryugi_real_dir "${CLAUDE_PROJECT_DIR:-$PWD}")"
project="$(ryugi_project_root "$session")"
state="$(ryugi_store "$project")/artifacts/.state"
[ -f "$state/server-info" ] || exit 0

"$bin" context "$project" "$session"
exit 0
