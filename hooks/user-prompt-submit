#!/usr/bin/env bash
set -uo pipefail

case "$0" in
  */* | *\\*) SCRIPT_DIR="$(cd "${0%[/\\]*}" && pwd)" ;;
  *) SCRIPT_DIR="$(pwd)" ;;
esac

is_antigravity=0
if [ -n "${ANTIGRAVITY_AGENT:-}" ] && [ -z "${CLAUDE_PROJECT_DIR:-}" ] && [ -z "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${CURSOR_PLUGIN_ROOT:-}" ]; then
  is_antigravity=1
fi

if ! command -v node > /dev/null 2>&1; then
  [ "$is_antigravity" -eq 1 ] && printf '{}\n'
  exit 0
fi

. "$SCRIPT_DIR/project-root.sh"
if [ "$is_antigravity" -eq 1 ]; then
  node "$SCRIPT_DIR/selection-context.cjs"
  exit 0
fi

session="$(ryugi_real_dir "${CLAUDE_PROJECT_DIR:-$PWD}")"
project="$(ryugi_project_root "$session")"
state="$project/.ryugi/artifacts/.state"
[ -f "$state/server-info" ] || exit 0

node "$SCRIPT_DIR/selection-context.cjs" "$project" "$session"
exit 0
