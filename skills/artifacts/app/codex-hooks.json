{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/skills/artifacts/app/codex-comment-watch.cjs\" watch",
            "async": true,
            "timeout": 86400
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/skills/artifacts/app/codex-comment-watch.cjs\" watch",
            "async": true,
            "timeout": 86400
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/skills/artifacts/app/codex-comment-watch.cjs\" stop",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
