{
  "name": "ryugi",
  "version": "1.44.0",
  "description": "Ryugi skills and runtime bootstrap for coding agents",
  "keywords": [
    "pi-package",
    "skills",
    "tdd",
    "debugging",
    "collaboration",
    "workflow"
  ],
  "license": "MIT",
  "type": "module",
  "main": ".opencode/plugins/ryugi.js",
  "scripts": {
    "format": "prettier --write .",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@lobehub/prettier-config": "^2.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-packagejson": "^3.0.3",
    "prettier-plugin-sh": "^0.20.2",
    "prettier-plugin-sort-json": "^4.2.0",
    "simple-git-hooks": "^2.14.0"
  },
  "pi": {
    "extensions": [
      "./.pi/extensions/ryugi.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
