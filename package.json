{
  "name": "adeck",
  "version": "1.118.1",
  "description": "Artideck — Interactive Artifacts for Coding Agents: artboards, design docs, whiteboards, HTML benches and verify reports",
  "keywords": [
    "pi-package",
    "omp-plugin",
    "skills",
    "tdd",
    "debugging",
    "collaboration",
    "workflow",
    "coding-agents",
    "ai-artifacts",
    "claude-code",
    "codex",
    "cursor",
    "artboard",
    "design-review",
    "whiteboard",
    "verify-reports"
  ],
  "homepage": "https://artideck.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/Innei/artideck.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": ".opencode/plugins/ryugi.js",
  "scripts": {
    "lint": "eslint . --fix",
    "prepare": "simple-git-hooks || true"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,yml,yaml}": "eslint --fix"
  },
  "devDependencies": {
    "@lobehub/eslint-config": "^2.1.7",
    "eslint": "^10.13.0",
    "lint-staged": "^17.6.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3"
  },
  "omp": {
    "extensions": [
      "./.omp/extensions/ryugi.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "pi": {
    "extensions": [
      "./.pi/extensions/ryugi.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
