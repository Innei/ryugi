{
  "name": "ryugi-artifacts",
  "version": "1.18.1",
  "type": "module",
  "description": "Server and viewer for the Ryugi artifacts app",
  "license": "MIT",
  "bin": {
    "ryugi-artifacts": "bin/ryugi-artifacts.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Innei/ryugi.git",
    "directory": "artifacts"
  },
  "files": [
    "bin",
    "dist/server.cjs",
    "dist/cli.cjs",
    "dist/viewer",
    "dist/runtime"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "pnpm run build:server && pnpm run build:cli && pnpm run build:viewer && pnpm run build:runtime",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --target=node18 --format=cjs --alias:loro-crdt=loro-crdt/base64 --outfile=dist/server.cjs && node -e \"const fs=require('node:fs');fs.copyFileSync('dist/server.cjs','../skills/artifacts/app/server.cjs')\"",
    "prepublishOnly": "pnpm build",
    "build:viewer": "NODE_ENV=production vite build && node -e \"const fs=require('node:fs');const to='../skills/artifacts/app/viewer';fs.rmSync(to,{recursive:true,force:true});fs.cpSync('dist/viewer',to,{recursive:true})\"",
    "build:runtime": "NODE_ENV=production vite build -c vite.runtime.config.ts && node scripts/inline-runtime-css.mjs",
    "dev": "vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:cli": "node scripts/build-cli.mjs"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@haklex/rich-collab-loro": "0.52.0",
    "@haklex/rich-editor": "0.52.0",
    "@haklex/rich-editor-ui": "0.52.0",
    "@haklex/rich-ext-chart": "0.52.0",
    "@haklex/rich-ext-excalidraw": "0.52.0",
    "@haklex/rich-headless": "0.52.0",
    "@haklex/rich-litexml": "0.52.0",
    "@haklex/rich-plugin-link-edit": "0.52.0",
    "@haklex/rich-renderer-alert": "0.52.0",
    "@haklex/rich-renderer-codeblock": "0.52.0",
    "@haklex/rich-renderer-image": "0.52.0",
    "@haklex/rich-renderer-katex": "0.52.0",
    "@haklex/rich-renderer-mermaid": "0.52.0",
    "@haklex/rich-style-token": "0.52.0",
    "@lexical/extension": "0.52.0",
    "@lexical/headless": "0.52.0",
    "@lexical/link": "0.52.0",
    "@lexical/list": "0.52.0",
    "@lexical/markdown": "0.52.0",
    "@lexical/react": "0.52.0",
    "@lexical/rich-text": "0.52.0",
    "@lexical/table": "0.52.0",
    "@lobehub/icons": "6.0.0",
    "@lobehub/ui": "6.5.1",
    "@stylexjs/stylex": "0.19.1",
    "@stylexjs/unplugin": "0.19.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "happy-dom": "20.14.6",
    "jotai": "^3.0.1",
    "katex": "^0.19.0",
    "lexical": "0.52.0",
    "loro-crdt": "1.16.4",
    "lucide-react": "^1.59.0",
    "motion": "^14.3.0",
    "nanoid": "^5.1.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-zoom-pan-pinch": "4.2.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "ws": "8.18.3"
  }
}
