{
  "name": "ryugi-artifacts",
  "version": "7.0.0",
  "type": "module",
  "description": "Prebuilt viewer for the Ryugi artifacts app, served from jsDelivr",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Innei/ryugi.git",
    "directory": "artifacts"
  },
  "files": [
    "dist/viewer"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "pnpm run build:server && pnpm run build:viewer",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --target=node18 --format=cjs --outfile=../skills/artifacts/app/server.cjs",
    "build:viewer": "NODE_ENV=production vite build && node -e \"const fs=require('node:fs');const to='../skills/artifacts/app/viewer';fs.rmSync(to,{recursive:true,force:true});fs.cpSync('dist/viewer',to,{recursive:true})\"",
    "dev": "vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@lobehub/ui": "6.5.1",
    "@stylexjs/stylex": "0.19.1",
    "lucide-react": "^1.59.0",
    "motion": "^14.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@stylexjs/unplugin": "0.19.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
