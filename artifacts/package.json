{
  "name": "ryugi-artifacts",
  "version": "1.49.5",
  "description": "Server and viewer for the Ryugi artifacts app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Innei/ryugi.git",
    "directory": "artifacts"
  },
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    "./viewer": {
      "types": "./dist/viewer-lib/types/src/viewer/library/index.d.ts",
      "default": "./dist/viewer-lib/index.js"
    },
    "./viewer/core": {
      "types": "./dist/viewer-lib/types/src/viewer/library/core.d.ts",
      "default": "./dist/viewer-lib/core.js"
    },
    "./viewer/document": {
      "types": "./dist/viewer-lib/types/src/viewer/library/document.d.ts",
      "default": "./dist/viewer-lib/document.js"
    },
    "./ids": {
      "types": "./dist/viewer-lib/types/src/shared/ids.d.ts",
      "default": "./dist/viewer-lib/ids.js"
    },
    "./thumbnail": {
      "types": "./dist/viewer-lib/types/src/shared/thumbnail.d.ts",
      "default": "./dist/viewer-lib/thumbnail.js"
    },
    "./viewer/shims": {
      "types": "./dist/viewer-lib/types/src/viewer/document/shims.d.ts",
      "default": "./dist/viewer-lib/shims.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "ryugi-artifacts": "bin/ryugi-artifacts.cjs"
  },
  "files": [
    "bin",
    "dist/server.cjs",
    "dist/cli.cjs",
    "dist/viewer",
    "dist/runtime",
    "dist/viewer-lib"
  ],
  "scripts": {
    "bench:zoom": "node bench/zoom/run.mjs",
    "build": "pnpm run build:server && pnpm run build:cli && pnpm run build:viewer && pnpm run build:lib && pnpm run build:runtime",
    "build:cli": "node scripts/build-cli.mjs",
    "build:lib": "NODE_ENV=production vite build -c vite.lib.config.ts && esbuild src/shared/thumbnail.ts --bundle --platform=neutral --format=esm --outfile=dist/viewer-lib/thumbnail.js && esbuild src/shared/ids.ts --bundle --platform=neutral --format=esm --outfile=dist/viewer-lib/ids.js && tsrs -p tsconfig.lib.json",
    "build:runtime": "NODE_ENV=production vite build -c vite.runtime.config.ts && node scripts/inline-runtime-css.mjs && node scripts/build-icons.mjs",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --target=node18 --format=cjs --alias:loro-crdt=loro-crdt/base64 --outfile=dist/server.cjs && node -e \"const fs=require('node:fs');fs.copyFileSync('dist/server.cjs','../skills/artifacts/app/server.cjs')\"",
    "build:viewer": "NODE_ENV=production vite build && node -e \"const fs=require('node:fs');const to='../skills/artifacts/app/viewer';fs.rmSync(to,{recursive:true,force:true});fs.cpSync('dist/viewer',to,{recursive:true})\"",
    "dev": "vite",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsrs --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@chenglou/pretext": "1.0.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@haklex/rich-collab-loro": "0.63.0",
    "@haklex/rich-compose": "0.63.0",
    "@haklex/rich-diff-core": "0.63.0",
    "@haklex/rich-editor": "0.63.0",
    "@haklex/rich-editor-ui": "0.63.0",
    "@haklex/rich-ext-chart": "0.63.0",
    "@haklex/rich-ext-excalidraw": "0.63.0",
    "@haklex/rich-ext-steps": "0.63.0",
    "@haklex/rich-headless": "0.63.0",
    "@haklex/rich-litexml": "0.63.0",
    "@haklex/rich-plugin-agent-stream": "0.63.0",
    "@haklex/rich-plugin-block-handle": "0.63.0",
    "@haklex/rich-plugin-link-edit": "0.63.0",
    "@haklex/rich-renderer-alert": "0.63.0",
    "@haklex/rich-renderer-codeblock": "0.63.0",
    "@haklex/rich-renderer-image": "0.63.0",
    "@haklex/rich-renderer-katex": "0.63.0",
    "@haklex/rich-renderer-mermaid": "0.63.0",
    "@haklex/rich-style-token": "0.63.0",
    "@lexical/extension": "0.53.0",
    "@lexical/headless": "0.53.0",
    "@lexical/link": "0.53.0",
    "@lexical/list": "0.53.0",
    "@lexical/markdown": "0.53.0",
    "@lexical/react": "0.53.0",
    "@lexical/rich-text": "0.53.0",
    "@lexical/table": "0.53.0",
    "@lobehub/fluent-emoji": "5.0.1",
    "@lobehub/icons": "6.9.1",
    "@lobehub/ui": "6.10.2",
    "@stylexjs/stylex": "0.19.1",
    "@stylexjs/unplugin": "0.19.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "happy-dom": "20.14.6",
    "i18next": "^26.5.6",
    "jotai": "^3.0.1",
    "katex": "^0.19.0",
    "lexical": "0.53.0",
    "loro-crdt": "1.16.4",
    "lucide-react": "^1.59.0",
    "motion": "^14.3.0",
    "nanoid": "^5.1.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.3",
    "react-zoom-pan-pinch": "4.2.0",
    "tsrs": "0.20.0-ts7.1.0-beta",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wouter": "3.13.0",
    "ws": "8.18.3"
  },
  "peerDependencies": {
    "@lobehub/ui": "^6.5.1",
    "i18next": "^26.5.6",
    "lucide-react": "^1.59.0",
    "motion": "^14.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.3"
  },
  "peerDependenciesMeta": {
    "@lobehub/ui": {
      "optional": true
    },
    "i18next": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "motion": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-i18next": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
